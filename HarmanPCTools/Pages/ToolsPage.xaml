<UserControl x:Class="HarmanPCTools.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="PC Toolkit" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Windows utilities and quick diagnostics, organized for fast everyday access." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <TextBlock Text="SYSTEM UTILITIES" Style="{StaticResource SectionTitleModern}" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
                <Button Content="📊  Task Manager" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource ToolsBrush}" Click="TaskManager_Click"/>
                <Button Content="🧩  Device Manager" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource SystemBrush}" Click="Device_Click"/>
                <Button Content="📝  Event Viewer" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource WindowsBrush}" Click="Event_Click"/>
                <Button Content="⚙  Services" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource CustomizeBrush}" Click="Services_Click"/>
                <Button Content="💾  Disk Management" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource NetworkBrush}" Click="Disk_Click"/>
                <Button Content="🛠  Control Panel" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource BorderBrush}" Click="Control_Click"/>
            </UniformGrid>

            <TextBlock Text="COMMAND &amp; SETTINGS" Style="{StaticResource SectionTitleModern}"/>
            <UniformGrid Columns="3">
                <Button Content="⌨  Command Prompt" Style="{StaticResource ToolGridButton}" Click="Cmd_Click"/>
                <Button Content=">_  PowerShell" Style="{StaticResource ToolGridButton}" Click="PowerShell_Click"/>
                <Button Content="🌐  Network Settings" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource NetworkBrush}" Click="Network_Click"/>
                <Button Content="🖥  Display Settings" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource WindowsBrush}" Click="Display_Click"/>
                <Button Content="🔊  Sound Settings" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource CustomizeBrush}" Click="Sound_Click"/>
                <Button Content="🔐  Windows Update" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource CleanupBrush}" Click="Update_Click"/>
            </UniformGrid>

            <TextBlock Text="NETWORK DIAGNOSTICS" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="QUICK PING TEST" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock Text="Test a host without opening Command Prompt." Style="{StaticResource ModernCardTitle}"/>
                        <TextBlock Text="Enter an IP address or hostname below." Style="{StaticResource ModernBody}" Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HostTextBox" Text="1.1.1.1" Width="180" Height="36" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Ping" Style="{StaticResource PrimaryButton}" Click="Ping_Click" Width="90"/>
                        </StackPanel>
                        <TextBlock x:Name="PingResultText" Text="Ready." Style="{StaticResource ModernBody}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="72" Height="72" CornerRadius="20" Background="{DynamicResource NetworkSoftBrush}" BorderBrush="{DynamicResource NetworkBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
