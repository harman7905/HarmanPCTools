<UserControl x:Class="HarmanPCTools.Pages.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Gaming Center" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Launch games, streaming tools and Windows gaming controls from one place." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ModernBadge}" VerticalAlignment="Top">
                    <TextBlock x:Name="ReadyText" Text="●  GAME READY" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <TextBlock Text="GAMING SESSION" Style="{StaticResource SectionTitleModern}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SESSION TIMER" Style="{StaticResource ModernCardEyebrow}"/>
                            <TextBlock x:Name="SessionTimerText" Text="00:00:00" Foreground="{DynamicResource TextBrush}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="Track your gaming session without changing system processes." Style="{StaticResource ModernBody}" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶  Start Session" Style="{StaticResource PrimaryButton}" Click="StartSession_Click" Margin="0,0,8,0"/>
                                <Button Content="■  Stop" Style="{StaticResource SecondaryButton}" Click="StopSession_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="76" Height="76" CornerRadius="20" Background="{DynamicResource GamingSoftBrush}" BorderBrush="{DynamicResource GamingBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GAMING WORKSPACE" Style="{StaticResource ModernCardEyebrow}"/>
                        <CheckBox x:Name="SteamCheck" Content="Launch Steam" IsChecked="True" Style="{StaticResource CheckBoxModern}"/>
                        <CheckBox x:Name="ObsCheck" Content="Launch OBS Studio" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🚀  Launch Workspace" Style="{StaticResource SecondaryButton}" Click="LaunchWorkspace_Click" Margin="0,0,8,0"/>
                            <Button Content="⚙  Configure OBS" Style="{StaticResource SecondaryButton}" Click="ConfigureObs_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="MY GAMES" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}" Padding="16" Background="{DynamicResource WindowSurfaceBrush}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Pinned games" Style="{StaticResource ModernCardTitle}"/>
                            <TextBlock Text="Add a game's .exe once and keep it here for quick launching." Style="{StaticResource ModernBody}" Margin="0,4,0,12"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ModernBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="QUICK LAUNCH" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="GamesPanel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="＋  Add Game" Style="{StaticResource PrimaryButton}" Click="AddGame_Click" Margin="0,0,8,0"/>
                        <Button Content="⟳  Refresh" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="STREAMING &amp; LAUNCHERS" Style="{StaticResource SectionTitleModern}"/>
            <UniformGrid Columns="3">
                <Button Content="🎮  Steam" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource GamingBrush}" Click="Steam_Click"/>
                <Button Content="🟣  Epic Games" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource CustomizeBrush}" Click="Epic_Click"/>
                <Button Content="📺  OBS Studio" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource ObsBrush}" Click="Obs_Click"/>
            </UniformGrid>

            <TextBlock Text="WINDOWS GAMING CONTROLS" Style="{StaticResource SectionTitleModern}"/>
            <UniformGrid Columns="3">
                <Button Content="⚡  Game Mode" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource GamingBrush}" Click="GameMode_Click"/>
                <Button Content="🖥  Display" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource WindowsBrush}" Click="Display_Click"/>
                <Button Content="🎯  Graphics Settings" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource CustomizeBrush}" Click="Graphics_Click"/>
                <Button Content="🌐  Network" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource NetworkBrush}" Click="Network_Click"/>
                <Button Content="📊  Task Manager" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource ToolsBrush}" Click="TaskManager_Click"/>
                <Button Content="🟩  NVIDIA Control Panel" Style="{StaticResource ToolGridButton}" BorderBrush="{DynamicResource StartupBrush}" Click="Nvidia_Click"/>
            </UniformGrid>

            <Border Style="{StaticResource ModernCard}" Margin="0,10,0,18" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                <StackPanel>
                    <TextBlock Text="SAFE GAMING PHILOSOPHY" Foreground="{DynamicResource SuccessBrush}" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Text="Harman PC Toolkit does not kill processes or make aggressive Windows changes automatically. The Gaming Center focuses on launch shortcuts, session tracking and safe Windows settings." Style="{StaticResource ModernBody}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
