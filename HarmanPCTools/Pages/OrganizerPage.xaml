<UserControl x:Class="HarmanPCTools.Pages.OrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="File Organizer" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Sort the top level of Downloads into practical folders with a preview before moving anything." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource ModernCard}" Background="{DynamicResource WindowSurfaceBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DOWNLOADS" Style="{StaticResource ModernCardEyebrow}"/>
                            <TextBlock x:Name="PathText" Style="{StaticResource ModernValue}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Style="{StaticResource ModernBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="PREVIEW FIRST" Foreground="{DynamicResource AccentBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ORGANIZATION PREVIEW" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="PreviewText" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⟳  Preview" Style="{StaticResource SecondaryButton}" Click="Preview_Click" Margin="0,0,8,0"/>
                        <Button Content="📁  Organize Downloads" Style="{StaticResource PrimaryButton}" Click="Organize_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="CATEGORIES" Style="{StaticResource SectionTitleModern}"/>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource OrganizerBrush}"><TextBlock Text="🖼  Images" Style="{StaticResource ModernCardTitle}"/></Border>
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource ToolsBrush}" Margin="5,0,5,10"><TextBlock Text="🎬  Videos" Style="{StaticResource ModernCardTitle}"/></Border>
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource CustomizeBrush}" Margin="5,0,0,10"><TextBlock Text="🎵  Audio" Style="{StaticResource ModernCardTitle}"/></Border>
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource WindowsBrush}"><TextBlock Text="📄  Documents" Style="{StaticResource ModernCardTitle}"/></Border>
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource NetworkBrush}" Margin="5,0,5,10"><TextBlock Text="🗜  Archives" Style="{StaticResource ModernCardTitle}"/></Border>
                <Border Style="{StaticResource ModernCardCompact}" BorderBrush="{DynamicResource BorderBrush}" Margin="5,0,0,10"><TextBlock Text="⚙  Programs / Other" Style="{StaticResource ModernCardTitle}"/></Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
