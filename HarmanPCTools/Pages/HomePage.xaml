<UserControl x:Class="HarmanPCTools.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Your PC is ready. Here's a quick look at what's happening."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" Background="#14291F" CornerRadius="15" Padding="12,7">
                <TextBlock x:Name="HealthText"
                           Text="●  SYSTEM HEALTHY"
                           Foreground="{StaticResource SuccessBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource MetricTitle}"/>
                    <TextBlock x:Name="CpuText" Text="--%" Style="{StaticResource MetricValue}"/>
                    <ProgressBar x:Name="CpuBar" Maximum="100" Style="{StaticResource MetricBar}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="MEMORY" Style="{StaticResource MetricTitle}"/>
                    <TextBlock x:Name="MemoryText" Text="--%" Style="{StaticResource MetricValue}"/>
                    <ProgressBar x:Name="MemoryBar" Maximum="100" Style="{StaticResource MetricBar}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="STORAGE" Style="{StaticResource MetricTitle}"/>
                    <TextBlock x:Name="StorageText" Text="--%" Style="{StaticResource MetricValue}"/>
                    <ProgressBar x:Name="StorageBar" Maximum="100" Style="{StaticResource MetricBar}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="FREE RAM" Style="{StaticResource MetricTitle}"/>
                    <TextBlock x:Name="FreeRamText" Text="-- GB" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="RamDetail" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <UniformGrid Columns="4">
                    <Button Content="🎮  Gaming" Style="{StaticResource CardButton}" Click="Gaming_Click"/>
                    <Button Content="♻  Clean PC" Style="{StaticResource CardButton}" Click="Cleanup_Click"/>
                    <Button Content="▣  System Info" Style="{StaticResource CardButton}" Click="System_Click"/>
                    <Button Content="🌐  Network" Style="{StaticResource CardButton}" Click="Network_Click"/>
                </UniformGrid>

                <TextBlock Text="PC STATUS" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MACHINE" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="WINDOWS" Style="{StaticResource InfoLabel}" Margin="0,13,0,0"/>
                                <TextBlock Text="UPTIME" Style="{StaticResource InfoLabel}" Margin="0,13,0,0"/>
                                <TextBlock Text="NETWORK" Style="{StaticResource InfoLabel}" Margin="0,13,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="MachineText" Style="{StaticResource InfoValue}"/>
                                <TextBlock x:Name="WindowsText" Style="{StaticResource InfoValue}" Margin="0,13,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="UptimeText" Style="{StaticResource InfoValue}" Margin="0,13,0,0"/>
                                <TextBlock x:Name="NetworkText" Style="{StaticResource InfoValue}" Margin="0,13,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="GpuText" Text="Detecting..."
                                       Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18"/>
                            <TextBlock Text="SYSTEM DRIVE" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="DriveText" Style="{StaticResource InfoValue}" Margin="0,6,0,18"/>
                            <TextBlock Text="Last refresh is automatic every second."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="FAVORITES" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="4">
                    <Button Content="GTA V" Style="{StaticResource CardButton}" Click="LaunchGta_Click"/>
                    <Button Content="OBS Studio" Style="{StaticResource CardButton}" Click="LaunchObs_Click"/>
                    <Button Content="Downloads" Style="{StaticResource CardButton}" Click="Downloads_Click"/>
                    <Button Content="Screenshots" Style="{StaticResource CardButton}" Click="Screenshots_Click"/>
                </UniformGrid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,8,0,20">
                    <StackPanel>
                        <TextBlock Text="Harman PC Tools" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="A personal Windows control center for gaming, organization, system information, cleanup, useful utilities and a little fun."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
