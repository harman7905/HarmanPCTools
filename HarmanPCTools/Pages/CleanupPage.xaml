<UserControl x:Class="HarmanPCTools.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Cleanup Center" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Remove safe temporary data and open Windows storage tools when deeper cleanup is needed." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="USER TEMPORARY FILES" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock x:Name="TempSizeText" Text="Calculating..." Foreground="{DynamicResource TextBrush}" FontSize="31" FontWeight="Bold"/>
                        <TextBlock x:Name="TempPathText" Style="{StaticResource ModernBody}" Margin="0,4,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⟳  Scan" Style="{StaticResource SecondaryButton}" Click="Scan_Click" Margin="0,0,8,0"/>
                            <Button Content="♻  Clean" Style="{StaticResource PrimaryButton}" Click="Clean_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="WINDOWS STORAGE" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock Text="Use Windows' own storage controls for system-level cleanup and Storage Sense." Style="{StaticResource ModernCardTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="These tools keep system cleanup under Windows itself." Style="{StaticResource ModernBody}" Margin="0,5,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Storage Settings" Style="{StaticResource SecondaryButton}" Click="Storage_Click" Margin="0,0,8,0"/>
                            <Button Content="Disk Cleanup" Style="{StaticResource SecondaryButton}" Click="DiskCleanup_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="SAFETY" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource CleanupSoftBrush}">
                        <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Safe by design" Style="{StaticResource ModernCardTitle}"/>
                        <TextBlock Text="This page only deletes items from the current user's temporary folder. Files in use or protected are skipped. System-level cleanup remains under Windows' own tools." Style="{StaticResource ModernBody}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
