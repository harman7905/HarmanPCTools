<UserControl x:Class="HarmanPCTools.Pages.FunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Fun Zone" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="A little personality for your PC toolkit, without getting in the way of the useful stuff." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource ModernCard}" Background="{DynamicResource WindowSurfaceBrush}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PC MOOD" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock x:Name="MoodText" Text="Ready when you are." Foreground="{DynamicResource TextBrush}" FontSize="29" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Button Content="🎲  Surprise Me" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left" Click="Surprise_Click"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="110" Height="110" CornerRadius="28" Background="{DynamicResource FunSoftBrush}" BorderBrush="{DynamicResource FunBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="☺" Foreground="{DynamicResource FunBrush}" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="HARMAN EASTER EGG" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CustomizeBrush}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="A hidden feature is planned" Style="{StaticResource ModernCardTitle}"/>
                    <TextBlock Text="The toolkit has a small easter egg section reserved for future builds. For now, this is just a playful placeholder." Style="{StaticResource ModernBody}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
