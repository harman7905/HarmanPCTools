<UserControl x:Class="HarmanPCTools.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="30" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="System Information" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Useful details about this Windows PC."
                       Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MACHINE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="MachineText" Style="{StaticResource InfoValue}" Margin="0,6,0,14"/>
                        <TextBlock Text="WINDOWS" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="WindowsText" Style="{StaticResource InfoValue}" Margin="0,6,0,14"/>
                        <TextBlock Text="PROCESSORS" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ProcessorText" Style="{StaticResource InfoValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY / STORAGE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="MemoryText" Style="{StaticResource InfoValue}" Margin="0,6,0,14"/>
                        <TextBlock Text="SYSTEM DRIVE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="DriveText" Style="{StaticResource InfoValue}" Margin="0,6,0,14"/>
                        <TextBlock Text="GPU" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource InfoValue}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                        <TextBlock Text="NETWORK" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="NetworkText" Style="{StaticResource InfoValue}" Margin="0,6,0,14"/>
                        <TextBlock Text="UPTIME" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource InfoValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="3">
                <Button Content="📋  Copy System Report" Style="{StaticResource CardButton}" Click="Copy_Click"/>
                <Button Content="🧩  Device Manager" Style="{StaticResource CardButton}" Click="Device_Click"/>
                <Button Content="🖥  System Settings" Style="{StaticResource CardButton}" Click="Settings_Click"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
