<UserControl x:Class="HarmanPCTools.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="System Information" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="A live snapshot of the hardware and Windows environment." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ModernBadge}" VerticalAlignment="Top">
                    <TextBlock Text="PC OVERVIEW" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MACHINE" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock x:Name="MachineText" Style="{StaticResource ModernValue}" Margin="0,0,0,16"/>
                        <TextBlock Text="WINDOWS" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="WindowsText" Style="{StaticResource ModernValue}" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        <TextBlock Text="PROCESSORS" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ProcessorText" Style="{StaticResource ModernValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="HARDWARE &amp; NETWORK" Style="{StaticResource ModernCardEyebrow}"/>
                        <TextBlock Text="MEMORY / STORAGE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="MemoryText" Style="{StaticResource ModernValue}" Margin="0,5,0,14"/>
                        <TextBlock Text="SYSTEM DRIVE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="DriveText" Style="{StaticResource ModernValue}" Margin="0,5,0,14"/>
                        <TextBlock Text="GPU" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource ModernValue}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                        <TextBlock Text="NETWORK" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="NetworkText" Style="{StaticResource ModernValue}" Margin="0,5,0,14"/>
                        <TextBlock Text="UPTIME" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource ModernValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitleModern}"/>
            <UniformGrid Columns="3">
                <Button Content="📋  Copy System Report" Style="{StaticResource ToolGridButton}" Click="Copy_Click"/>
                <Button Content="🧩  Device Manager" Style="{StaticResource ToolGridButton}" Click="Device_Click"/>
                <Button Content="🖥  System Settings" Style="{StaticResource ToolGridButton}" Click="Settings_Click"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
