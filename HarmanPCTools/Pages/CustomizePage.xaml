<UserControl x:Class="HarmanPCTools.Pages.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="28,24,0,24" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Customize" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Choose a polished visual style for Harman PC Toolkit. Changes apply immediately and are remembered." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <TextBlock Text="THEMES" Style="{StaticResource SectionTitleModern}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ModernCard}" Background="{DynamicResource WindowSurfaceBrush}">
                <WrapPanel x:Name="ThemePanel"/>
            </Border>

            <TextBlock Text="CURRENT THEME" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="ThemeSwatch" Width="38" Height="38" CornerRadius="11" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ThemeNameText" Style="{StaticResource ModernValue}"/>
                        <TextBlock Text="Applied immediately and saved automatically." Style="{StaticResource ModernBody}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ModernBadge}" VerticalAlignment="Top">
                        <TextBlock Text="LIVE" Foreground="{DynamicResource AccentBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="DESIGN PHILOSOPHY" Style="{StaticResource SectionTitleModern}"/>
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,18">
                <TextBlock Text="Themes are intentionally dark, understated and gaming-friendly. Hover states stay subtle so the interface remains calm while you move through the toolkit." Style="{StaticResource ModernBody}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
