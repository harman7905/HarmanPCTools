<Window x:Class="HarmanPCTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harman PC Tools"
        Width="1240"
        Height="780"
        MinWidth="1000"
        MinHeight="680"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="HARMAN" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="PC TOOLS" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,-1,0,26"/>

                    <Button x:Name="HomeNav" Content="⌂   Home" Tag="Home" Click="Nav_Click" Style="{StaticResource NavButtonActive}"/>
                    <Button x:Name="GamingNav" Content="🎮  Gaming" Tag="Gaming" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="SystemNav" Content="▣   System" Tag="System" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="CleanupNav" Content="♻   Cleanup" Tag="Cleanup" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="OrganizerNav" Content="📁  Organizer" Tag="Organizer" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="ToolsNav" Content="⚙   Tools" Tag="Tools" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="StartupNav" Content="🚀  Startup" Tag="Startup" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="CustomizeNav" Content="✦   Customize" Tag="Customize" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="FunNav" Content="☻   Fun" Tag="Fun" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="AboutNav" Content="ⓘ   About" Tag="About" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="Harman PC Tools • v2.0.2" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,14,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost"/>
        </Grid>
    </Grid>
</Window>
