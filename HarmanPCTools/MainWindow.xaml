<Window x:Class="HarmanPCTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harman PC Toolkit"
        Width="1320"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <TextBlock Text="H" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="23" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="HARMAN" Foreground="{DynamicResource TextBrush}"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="PC TOOLKIT" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SidebarSectionLabel}"/>
                        <Button x:Name="HomeNav" Content="⌂   Home" Tag="Home" Click="Nav_Click" Style="{StaticResource NavButtonActive}"/>
                        <Button x:Name="GamingNav" Content="🎮  Gaming" Tag="Gaming" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="SystemNav" Content="▣   System" Tag="System" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="CleanupNav" Content="♻   Cleanup" Tag="Cleanup" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="OrganizerNav" Content="📁  Organizer" Tag="Organizer" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="ToolsNav" Content="⚙   Tools" Tag="Tools" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="StartupNav" Content="🚀  Startup" Tag="Startup" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="CustomizeNav" Content="✦   Customize" Tag="Customize" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="FunNav" Content="☻   Fun" Tag="Fun" Click="Nav_Click" Style="{StaticResource NavButton}"/>

                        <TextBlock Text="APP" Style="{StaticResource SidebarSectionLabel}" Margin="6,26,0,8"/>
                        <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="AboutNav" Content="ⓘ   About" Tag="About" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="4,14,4,0" Padding="12,10"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="READY" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Windows PC toolkit" Foreground="{DynamicResource TextBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="Designed by Harman" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="10" Margin="0,2,0,0"/>
                        <TextBlock Text="v2.1.0" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="9.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22,20,24,22">
            <Border Background="{DynamicResource WindowSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18"/>
            <ContentControl x:Name="PageHost" Margin="8"/>
        </Grid>
    </Grid>
</Window>
